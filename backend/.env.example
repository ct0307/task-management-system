# 后端环境变量配置

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_system_db
DB_USER=root
DB_PASSWORD=your_password
DB_CONNECTION_LIMIT=10

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3000

# 前端地址（CORS）
CORS_ORIGIN=http://localhost:5173

# 课程表/文件解析引擎
# 默认读取项目根目录 parse_engine.py；部署到其他路径时再覆盖
PYTHON_BIN=python
PARSE_ENGINE_PATH=../parse_engine.py
PARSE_ENGINE_TIMEOUT_MS=60000
PARSE_ENGINE_MAX_BUFFER_MB=10
